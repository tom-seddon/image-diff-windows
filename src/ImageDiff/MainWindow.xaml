<Window x:Class="ImageDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Diff" Width="1200" Height="800" MinWidth="640" MinHeight="400"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Background" Value="#808080" />
        </Style>
        <Style x:Key="Canvas" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource Checkerboard}" />
        </Style>
        <Style TargetType="Image">
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Image selection -->
        <Grid DockPanel.Dock="Top" Margin="6,6,6,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Left:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="LeftPathBox" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                     AllowDrop="True" PreviewDragOver="PathBox_PreviewDragOver" PreviewDrop="PathBox_PreviewDrop"
                     KeyDown="PathBox_KeyDown" ToolTip="Path of the left (original) image. Press Enter to compare." />
            <Button Grid.Column="2" Content="Browse…" Click="BrowseLeft_Click" />

            <TextBlock Grid.Row="1" Text="Right:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="RightPathBox" Grid.Row="1" Grid.Column="1" Margin="0,2" VerticalContentAlignment="Center"
                     AllowDrop="True" PreviewDragOver="PathBox_PreviewDragOver" PreviewDrop="PathBox_PreviewDrop"
                     KeyDown="PathBox_KeyDown" ToolTip="Path of the right (changed) image. Press Enter to compare." />
            <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseRight_Click" />

            <StackPanel Grid.Column="3" Grid.RowSpan="2" Orientation="Vertical" VerticalAlignment="Center">
                <Button Content="Compare" FontWeight="SemiBold" Click="Compare_Click" ToolTip="Load both images and compare (F5)" />
                <Button Content="Swap" Click="Swap_Click" ToolTip="Swap left and right" />
            </StackPanel>
        </Grid>

        <!-- View options -->
        <Border DockPanel.Dock="Top" BorderBrush="#D0D0D0" BorderThickness="0,1" Padding="6,4">
            <WrapPanel>
                <TextBlock Text="View:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <RadioButton x:Name="DiffModeButton" Content="Difference" GroupName="Mode" IsChecked="True" Checked="Mode_Checked" ToolTip="Highlight changed pixels (1)" />
                <RadioButton x:Name="FlipModeButton" Content="Flip" GroupName="Mode" Checked="Mode_Checked" ToolTip="Show one image at a time; Space or click switches instantly (2)" />
                <Button x:Name="FlipButton" Content="Show right" Click="Flip_Click" IsEnabled="False" Margin="0,0,4,0" MinWidth="90"
                        ToolTip="Switch between left and right (Space, or click the image)" />

                <Separator Margin="8,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                <TextBlock Text="Tolerance:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="ToleranceSlider" Width="140" Minimum="0" Maximum="255" Value="0"
                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="8"
                        VerticalAlignment="Center" ValueChanged="Tolerance_ValueChanged"
                        ToolTip="Ignore per-channel differences up to this amount (0-255)" />
                <TextBlock x:Name="ToleranceText" Text="0" Width="28" Margin="6,0,0,0" VerticalAlignment="Center" />

                <Separator Margin="8,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Content="Fit" Click="ZoomFit_Click" ToolTip="Fit to window (Ctrl+0)" Margin="2,0" />
                <Button Content="100%" Click="ZoomActual_Click" ToolTip="Actual pixels (Ctrl+1)" Margin="2,0" />
                <TextBlock x:Name="ZoomText" Text="100%" Width="48" Margin="6,0,0,0" VerticalAlignment="Center"
                           ToolTip="Ctrl + mouse wheel to zoom" />

                <Separator Margin="8,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                <Button x:Name="SaveDiffButton" Content="Save difference…" Click="SaveDiff_Click" IsEnabled="False" Margin="2,0" />
            </WrapPanel>
        </Border>

        <!-- Status -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="SummaryText" Text="Choose two images, or drop them onto this window." />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PixelText" FontFamily="Consolas" />
            </StatusBarItem>
        </StatusBar>

        <!-- View: one canvas holds the difference image and both originals; the mode picks which is visible. -->
        <Grid x:Name="ViewHost">
            <ScrollViewer x:Name="ViewScroll">
                <Grid x:Name="ViewCanvas" Style="{StaticResource Canvas}">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="ViewScale" />
                    </Grid.LayoutTransform>
                    <Image x:Name="DiffImage" />
                    <Image x:Name="LeftImage" Visibility="Collapsed" />
                    <Image x:Name="RightImage" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>

            <!-- Which image is showing in Flip view. Outside the scroll area so it stays put and unscaled. -->
            <Border x:Name="FlipBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                    Padding="8,3" CornerRadius="3" Background="#CC000000" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="FlipBadgeText" Foreground="White" FontWeight="SemiBold" />
            </Border>

            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="White" FontSize="16" TextAlignment="Center" IsHitTestVisible="False"
                       Text="Drop two images here, or choose them above.&#x0a;You can also run: ImageDiff left.png right.png" />
        </Grid>
    </DockPanel>
</Window>
